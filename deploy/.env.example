# cp .env.example .env && chmod 600 .env
BIND_IP=127.0.0.1        # or the host's Tailscale IPv4 (tailscale ip -4); never a public/wildcard address
TS_AUTHKEY=              # reusable, non-ephemeral; only for sidecar profiles (docs/tailscale.md)

# --- danmaku (docs/3-danmaku.md) ---
MISAKA_DB_PASSWORD=      # Postgres password for misaka-db (choose one)
MISAKA_API_KEY=          # Misaka UI → 外部控制 → API 密钥
SONARR_API_KEY=          # Sonarr API key
RADARR_API_KEY=          # Radarr API key
WEBHOOK_SECRET=          # basic-auth password Sonarr/Radarr send to the bridge (choose one)
LIBRETV_PASSWORD=        # LibreTV's own login (libretv profile only)
LIBRETV_MISAKA_TOKEN=    # Misaka UI → 弹幕 → Token管理, one just for LibreTV (libretv profile only)
