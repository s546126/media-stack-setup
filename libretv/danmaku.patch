+import { describe, expect, it } from 'vitest';
+import { buildMatchFileName, cleanTitle, convertDandanComments } from './danmaku';
+
+describe('convertDandanComments', () => {
+  it('maps dandanplay p fields to artplayer danmaku', () => {
+    expect(
+      convertDandanComments([
+        { cid: 1, p: '12.5,1,16777215,[bilibili]', m: '前方高能' },
+        { cid: 2, p: '3,5,16711680', m: '顶部' },
+        { cid: 3, p: '7,4,255', m: '底部' },
+      ])
+    ).toEqual([
+      { text: '顶部', time: 3, mode: 1, color: '#ff0000' },
+      { text: '底部', time: 7, mode: 2, color: '#0000ff' },
+      { text: '前方高能', time: 12.5, mode: 0, color: '#ffffff' },
+    ]);
+  });
+
+  it('drops malformed entries', () => {
+    expect(convertDandanComments([{ p: 'x,1,0', m: 'a' }, { p: '1,1,0', m: '' }])).toEqual([]);
+  });
+});
+
+describe('buildMatchFileName', () => {
+  it('uses 第N集 for series and title (+year) for movies', () => {
+    expect(buildMatchFileName({ title: '繁花', episode: 5, total: 30 })).toBe('繁花 第5集');
+    expect(buildMatchFileName({ title: '流浪地球2', episode: 1, total: 1, year: '2023' })).toBe('流浪地球2 (2023)');
+  });
+
+  it('strips source decorations but keeps season words', () => {
+    expect(cleanTitle('庆余年第二季[HD]国语版')).toBe('庆余年第二季');
+    expect(cleanTitle('葬送的芙莉莲（2023）')).toBe('葬送的芙莉莲');
+  });
+});
diff --git a/src/lib/danmaku.ts b/src/lib/danmaku.ts
new file mode 100644
index 0000000..fe75f14
--- /dev/null
+++ b/src/lib/danmaku.ts
@@ -0,0 +1,76 @@
+/**
+ * 弹幕（弹弹play 兼容接口，如自建 Misaka）的纯函数部分：前后端共用，便于单测。
+ * 网络请求在 misaka.ts（服务端），播放器侧只消费 DanmakuItem[]。
+ */
+
+/** artplayer-plugin-danmuku 的弹幕项（mode: 0 滚动 / 1 顶部 / 2 底部） */
+export interface DanmakuItem {
+  text: string;
+  time: number;
+  mode: 0 | 1 | 2;
+  color: string;
+}
+
+/** 播放页传给播放器的「这一集是什么」：采集站不给外部 ID，只能靠剧名 + 集号匹配 */
+export interface DanmakuQuery {
+  title: string;
+  /** 第几集，从 1 开始 */
+  episode: number;
+  /** 分集总数：1 视为电影 */
+  total: number;
+  year?: string;
+}
+
+/** /api/danmaku 的响应 */
+export interface DanmakuResponse {
+  /** 服务端未配置 MISAKA_URL 时为 false，播放器据此不挂弹幕插件 */
+  enabled: boolean;
+  matched?: { animeTitle: string; episodeTitle: string; episodeId: number };
+  comments: DanmakuItem[];
+}
+
+/** 弹弹play 的 comment.p：`time,mode,color[,source]`，mode 1 滚动 / 4 底部 / 5 顶部 */
+export interface DandanComment {
+  cid?: number;
+  p: string;
+  m: string;
+}
+
+export function convertDandanComments(comments: DandanComment[]): DanmakuItem[] {
+  const out: DanmakuItem[] = [];
+  for (const c of comments) {
+    if (!c || typeof c.p !== 'string' || !c.m) continue;
+    const [t, mode, color] = c.p.split(',');
+    const time = Number(t);
+    if (!Number.isFinite(time) || time < 0) continue;
+    const colorNum = Number(color);
+    out.push({
+      text: c.m,
+      time,
+      mode: mode === '4' ? 2 : mode === '5' ? 1 : 0,
+      color: Number.isFinite(colorNum)
+        ? `#${(colorNum & 0xffffff).toString(16).padStart(6, '0')}`
+        : '#ffffff',
+    });
+  }
+  return out.sort((a, b) => a.time - b.time);
+}
+
+/**
+ * 采集站剧名常带「国语版」「[HD]」「(2024)」之类的尾巴，匹配前去掉。
+ * 「第二季」保留：Misaka 的文件名解析会把它识别成季号。
+ */
+export function cleanTitle(title: string): string {
+  return title
+    .replace(/[[【(（][^\]】)）]*[\]】)）]/g, ' ')
+    .replace(/(国语|粤语|日语|英语|中字|普通话|高清|蓝光|未删减|完整)版?/g, ' ')
+    .replace(/\s+/g, ' ')
+    .trim();
+}
+
+/** 给 /match 用的「文件名」：电影只给剧名（+年份），剧集给「剧名 第N集」 */
+export function buildMatchFileName(q: DanmakuQuery): string {
+  const title = cleanTitle(q.title);
+  if (q.total <= 1) return q.year ? `${title} (${q.year})` : title;
+  return `${title} 第${q.episode}集`;
+}
diff --git a/src/lib/misaka.ts b/src/lib/misaka.ts
new file mode 100644
index 0000000..493c13f
--- /dev/null
+++ b/src/lib/misaka.ts
@@ -0,0 +1,90 @@
+import {
+  buildMatchFileName,
+  cleanTitle,
+  convertDandanComments,
+  type DandanComment,
+  type DanmakuQuery,
+  type DanmakuResponse,
+} from './danmaku';
+
+/**
+ * 服务端对接弹弹play 兼容弹幕服务（Misaka danmu server）。
+ * MISAKA_URL 例：https://misaka.tailnet.ts.net（服务端直连，不经浏览器，没有混合内容/CORS 问题）
+ * MISAKA_TOKEN：Misaka「弹幕 → Token管理」里建的 token，只留在服务端，不下发浏览器。
+ */
+export function getMisakaBase(): string | null {
+  const url = process.env.MISAKA_URL?.trim().replace(/\/+$/, '');
+  const token = process.env.MISAKA_TOKEN?.trim();
+  if (!url || !token) return null;
+  return `${url}/api/v1/${encodeURIComponent(token)}/api/v2`;
+}
+
+// 后备匹配会在 Misaka 侧全网搜索并导入，首次可能要几十秒（matchFallbackTimeout 默认 60s）
+const MATCH_TIMEOUT_MS = 70_000;
+const COMMENT_TIMEOUT_MS = 30_000;
+// 同一集的匹配结果缓存，避免换源/刷新反复触发 Misaka 后备搜索
+const MATCH_CACHE_TTL_MS = 6 * 60 * 60_000;
+const matchCache = new Map<string, { at: number; value: DanmakuResponse['matched'] | null }>();
+
+async function getJson<T>(url: string, init: RequestInit, timeoutMs: number): Promise<T> {
+  const res = await fetch(url, { ...init, signal: AbortSignal.timeout(timeoutMs), cache: 'no-store' });
+  if (!res.ok) throw new Error(`Misaka HTTP ${res.status}`);
+  return (await res.json()) as T;
+}
+
+interface MatchResp {
+  isMatched?: boolean;
+  matches?: { episodeId: number; animeTitle: string; episodeTitle: string }[];
+}
+interface SearchEpisodesResp {
+  animes?: { animeTitle: string; episodes?: { episodeId: number; episodeTitle: string }[] }[];
+}
+
+async function resolveEpisode(base: string, q: DanmakuQuery): Promise<DanmakuResponse['matched'] | null> {
+  // 1) /match：库内匹配，未命中时由 Misaka 后备匹配（需在其设置中开启）全网搜索 + 导入
+  const match = await getJson<MatchResp>(
+    `${base}/match`,
+    {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ fileName: buildMatchFileName(q), matchMode: 'fileNameOnly' }),
+    },
+    MATCH_TIMEOUT_MS
+  );
+  const m = match.isMatched ? match.matches?.[0] : undefined;
+  if (m) return { episodeId: m.episodeId, animeTitle: m.animeTitle, episodeTitle: m.episodeTitle };
+
+  // 2) /search/episodes：按剧名 + 集号查库，兜住文件名解析没认出来的情况
+  const params = new URLSearchParams({ anime: cleanTitle(q.title) });
+  if (q.total > 1) params.set('episode', String(q.episode));
+  const search = await getJson<SearchEpisodesResp>(`${base}/search/episodes?${params}`, {}, COMMENT_TIMEOUT_MS);
+  for (const anime of search.animes ?? []) {
+    const ep = anime.episodes?.[0];
+    if (ep) return { episodeId: ep.episodeId, animeTitle: anime.animeTitle, episodeTitle: ep.episodeTitle };
+  }
+  return null;
+}
+
+export async function fetchDanmaku(q: DanmakuQuery): Promise<DanmakuResponse> {
+  const base = getMisakaBase();
+  if (!base) return { enabled: false, comments: [] };
+
+  const key = `${cleanTitle(q.title)}|${q.year ?? ''}|${q.total}|${q.episode}`;
+  const hit = matchCache.get(key);
+  let matched: DanmakuResponse['matched'] | null;
+  if (hit && Date.now() - hit.at < MATCH_CACHE_TTL_MS) {
+    matched = hit.value;
+  } else {
+    matched = await resolveEpisode(base, q);
+    // 没匹配上也缓存，但只缓存 10 分钟：Misaka 后台导入可能稍后完成
+    matchCache.set(key, { at: matched ? Date.now() : Date.now() - MATCH_CACHE_TTL_MS + 10 * 60_000, value: matched });
+  }
+  if (!matched) return { enabled: true, comments: [] };
+
+  const data = await getJson<{ comments?: DandanComment[] }>(
+    `${base}/comment/${matched.episodeId}?withRelated=true&chConvert=1`,
+    {},
+    COMMENT_TIMEOUT_MS
+  );
+  return { enabled: true, matched, comments: convertDandanComments(data.comments ?? []) };
+}
