+import { NextResponse } from 'next/server';
+import { guardRequest, jsonError } from '@/lib/api-guard';
+import { fetchDanmaku } from '@/lib/misaka';
+
+export const runtime = 'nodejs';
+
+/** 弹幕：按剧名 + 集号到自建弹弹play 兼容服务（MISAKA_URL）匹配并取弹幕 */
+export async function GET(req: Request) {
+  const guarded = guardRequest(req);
+  if (guarded) return guarded;
+
+  const params = new URL(req.url).searchParams;
+  const title = (params.get('title') || '').trim().slice(0, 200);
+  const episode = parseInt(params.get('episode') || '1', 10);
+  const total = parseInt(params.get('total') || '1', 10);
+  const year = (params.get('year') || '').trim().slice(0, 8) || undefined;
+  if (!title || !(episode >= 1) || !(total >= 1)) return jsonError('参数无效', 400);
+
+  try {
+    return NextResponse.json(await fetchDanmaku({ title, episode, total, year }));
+  } catch (err) {
+    return jsonError(err instanceof Error ? err.message : '弹幕获取失败', 502);
+  }
+}
